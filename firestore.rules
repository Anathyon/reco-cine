rules_version = '2';

// Cada pessoa só lê e escreve a própria lista:
//   users/{uid}/favorites/{tipo-id}
// e a própria data de nascimento (para a busca +18), gravada uma única vez:
//   users/{uid}  { birthDate: "AAAA-MM-DD", confirmedAt }
// Publique com `npx firebase-tools deploy --only firestore:rules`
// ou cole este arquivo em Firebase Console → Firestore → Regras.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function optionalString(d, field, max) {
      return !(field in d) || d[field] == null || (d[field] is string && d[field].size() <= max);
    }

    function validFavorite(d, favId) {
      return d.keys().hasAll(['id', 'type', 'title', 'addedAt'])
        && d.keys().hasOnly(['id', 'type', 'title', 'poster', 'backdrop', 'year', 'rating', 'overview', 'addedAt'])
        && d.id is int && d.id > 0
        && d.type in ['movie', 'tv', 'anime']
        && favId == d.type + '-' + string(d.id)
        && d.title is string && d.title.size() > 0 && d.title.size() <= 300
        && d.addedAt is number
        && optionalString(d, 'poster', 500)
        && optionalString(d, 'backdrop', 500)
        && optionalString(d, 'year', 10)
        && optionalString(d, 'overview', 5000)
        && (!('rating' in d) || d.rating == null || d.rating is number);
    }

    function validBirthDate(d) {
      return d.keys().hasOnly(['birthDate', 'confirmedAt'])
        && d.birthDate is string
        && d.birthDate.matches('^(19|20)[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && d.confirmedAt == request.time;
    }

    // Sem update nem delete: a data não pode ser trocada depois de informada.
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid) && validBirthDate(request.resource.data);
    }

    match /users/{uid}/favorites/{favId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validFavorite(request.resource.data, favId);
    }

    // Todo o resto fica fechado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
