# Chave da API v3 do TMDB (https://www.themoviedb.org/settings/api).
# Usada apenas no servidor, pela rota /api/tmdb — não vai para o navegador.
# TMDB_API_KEY também é aceita; NEXT_PUBLIC_TMDB_API_KEY é mantida por compatibilidade.
NEXT_PUBLIC_TMDB_API_KEY=sua_chave_aqui
NEXT_PUBLIC_TMDB_BASE_URL=https://api.themoviedb.org/3
NEXT_PUBLIC_TMDB_IMAGE_BASE=https://image.tmdb.org/t/p
NEXT_PUBLIC_JIKAN_BASE_URL=https://api.jikan.moe/v4

# Client ID do MyAnimeList (https://myanimelist.net/apiconfig → Create ID, tipo "web").
# Usado apenas no servidor, pela rota /api/anime. O Client Secret não é necessário.
MAL_CLIENT_ID=seu_client_id_aqui

# Firebase (login com Google e lista salva na conta). Opcional: sem estas
# variáveis, o botão "Entrar" some e a lista fica só no aparelho.
# Firebase Console → Configurações do projeto → Seus apps → App da Web → firebaseConfig.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
