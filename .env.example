# Chave da API v3 do TMDB (https://www.themoviedb.org/settings/api).
# Usada apenas no servidor, pela rota /api/tmdb — não vai para o navegador.
# TMDB_API_KEY também é aceita; NEXT_PUBLIC_TMDB_API_KEY é mantida por compatibilidade.
NEXT_PUBLIC_TMDB_API_KEY=sua_chave_aqui
NEXT_PUBLIC_TMDB_BASE_URL=https://api.themoviedb.org/3
NEXT_PUBLIC_TMDB_IMAGE_BASE=https://image.tmdb.org/t/p
NEXT_PUBLIC_JIKAN_BASE_URL=https://api.jikan.moe/v4
